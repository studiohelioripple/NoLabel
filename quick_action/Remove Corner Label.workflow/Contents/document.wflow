				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

NOLABEL_CLI="$HOME/.local/bin/nolabel"
if [ ! -x "$NOLABEL_CLI" ]; then
    NOLABEL_CLI="$HOME/.local/share/nolabel/bin/nolabel"
fi

if [ ! -x "$NOLABEL_CLI" ]; then
    osascript -e 'display alert "NoLabel Error" message "NoLabel CLI not found at ~/.local/bin/nolabel." as critical'
    exit 1
fi

TOTAL=0
for f in "$@"; do
    if [ -e "$f" ]; then
        TOTAL=$((TOTAL + 1))
    fi
done

if [ "$TOTAL" -eq 0 ]; then
    exit 0
fi

if [ "$TOTAL" -gt 1 ]; then
    osascript -e "display notification \"Processing $TOTAL item(s) for corner label removal...\" with title \"NoLabel\" sound name \"Tink\""
fi

SUCCESS_COUNT=0
for f in "$@"; do
    if [ ! -e "$f" ]; then
        continue
    fi
    if "$NOLABEL_CLI" process "$f"; then
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    fi
done

if [ "$SUCCESS_COUNT" -gt 0 ]; then
    if [ "$SUCCESS_COUNT" -eq 1 ] &amp;&amp; [ "$TOTAL" -eq 1 ]; then
        osascript -e "display notification \"Label removal completed for $(basename "$1")\" with title \"NoLabel\" subtitle \"Original saved to backup/\" sound name \"Glass\""
    else
        osascript -e "display notification \"Label removal completed for $SUCCESS_COUNT of $TOTAL files\" with title \"NoLabel\" subtitle \"Originals saved to backup/\" sound name \"Glass\""
    fi
fi
</string>
					<key>CheckedForUserDefault</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
