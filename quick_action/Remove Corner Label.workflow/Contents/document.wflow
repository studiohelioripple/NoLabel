NOLABEL_CLI="$HOME/.local/bin/nolabel"
if [ ! -x "$NOLABEL_CLI" ]; then
    NOLABEL_CLI="$HOME/.local/share/nolabel/bin/nolabel"
fi

if [ ! -x "$NOLABEL_CLI" ]; then
    osascript -e 'display alert "NoLabel Error" message "NoLabel CLI not found at ~/.local/bin/nolabel." as critical'
    exit 1
fi

TOTAL=0
for f in "$@"; do
    if [ -e "$f" ]; then
        TOTAL=$((TOTAL + 1))
    fi
done

if [ "$TOTAL" -eq 0 ]; then
    exit 0
fi

if [ "$TOTAL" -gt 1 ]; then
